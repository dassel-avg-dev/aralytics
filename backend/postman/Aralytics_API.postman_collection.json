{
  "info": {
    "name": "Aralytics API",
    "description": "Core auth, student and teacher flows for the Aralytics Spring Boot backend. Run the two Login requests first: their test scripts save the JWTs to the studentToken / teacherToken collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "studentToken", "value": "", "type": "string" },
    { "key": "teacherToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Student)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"miguel@school.edu.ph\",\n  \"password\": \"student123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "auth": { "type": "noauth" },
            "description": "Signs in the seeded student and saves the JWT to {{studentToken}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('studentToken', body.token);",
                  "pm.test('studentToken saved', function () {",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (Teacher)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"maria.santos@university.edu.ph\",\n  \"password\": \"teacher123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "auth": { "type": "noauth" },
            "description": "Signs in the seeded teacher and saves the JWT to {{teacherToken}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('teacherToken', body.token);",
                  "pm.test('teacherToken saved', function () {",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Key (Activation)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"institutionCode\": \"STJUDE-MNL-2025\",\n  \"accessKey\": \"KEY-8821-PY\",\n  \"role\": \"STUDENT\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-key",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-key"]
            },
            "auth": { "type": "noauth" },
            "description": "Public endpoint. Validates a school activation key and returns a short-lived activation token (no account is created)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('activation token returned', function () {",
                  "    pm.expect(pm.response.json().activationToken).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Student Endpoints",
      "item": [
        {
          "name": "Get My Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/student/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "student", "dashboard"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get My Activities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/student/activities",
              "host": ["{{baseUrl}}"],
              "path": ["api", "student", "activities"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Quiz by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/student/quiz/2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "student", "quiz", "2"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            },
            "description": "Quiz 2 from the seed data (\"Variables and Data Types\"). Correct answers are never included in the response."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('quiz has questions', function () {",
                  "    pm.expect(pm.response.json().questions.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit Quiz",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    { \"questionId\": 1, \"selectedOption\": \"A\" },\n    { \"questionId\": 2, \"selectedOption\": \"A\" },\n    { \"questionId\": 3, \"selectedOption\": \"A\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/student/quiz/1/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "student", "quiz", "1", "submit"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            },
            "description": "Submits quiz 1 (\"Debugging Python Loops\"). Quiz 2 is already submitted by the seeded student, so submitting it again would return 409. Returns 200 when feedback is READY, 202 when PENDING."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('scored or pending (200/202)', function () {",
                  "    pm.expect([200, 202]).to.include(pm.response.code);",
                  "});",
                  "if ([200, 202].includes(pm.response.code)) {",
                  "    pm.test('score returned', function () {",
                  "        pm.expect(pm.response.json().score).to.be.a('number');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Feedback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/student/feedback/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "student", "feedback", "1"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            },
            "description": "Feedback for submission 1, which the seed data creates for this student (quiz 2)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 READY or 202 PENDING', function () {",
                  "    pm.expect([200, 202]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Teacher Endpoints",
      "item": [
        {
          "name": "Get Teacher Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/teacher/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teacher", "dashboard"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Student Roster",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/teacher/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teacher", "students"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Activity (Draft)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Quiz\",\n  \"description\": \"Created from the Postman collection\",\n  \"classId\": 1,\n  \"questions\": [\n    {\n      \"text\": \"Test prompt?\",\n      \"options\": [\n        { \"key\": \"A\", \"text\": \"Option A\" },\n        { \"key\": \"B\", \"text\": \"Option B\" },\n        { \"key\": \"C\", \"text\": \"Option C\" },\n        { \"key\": \"D\", \"text\": \"Option D\" }\n      ],\n      \"correctAnswer\": \"A\",\n      \"points\": 1,\n      \"concepts\": [\"loops\"]\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/teacher/activities",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teacher", "activities"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }]
            },
            "description": "Creates a DRAFT activity owned by the seeded teacher. The body matches CreateQuizRequest: options use key/text, and correctAnswer must match one option key."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('created as DRAFT', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('DRAFT');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Export CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/teacher/reports/export-csv",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teacher", "reports", "export-csv"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }]
            },
            "description": "Returns the roster as a CSV attachment. In Postman use Send and Download to save the file."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('CSV content type', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
